# Copy to .env (local dev) or provide equivalent values via your deployment
# platform's secret/environment mechanism. Names only — never commit real
# values. See docs/security.md and docs/deployment.md.

# --- Application ---
# Node environment; "development" locally, "production" on the VPS.
NODE_ENV=development
# Fully-qualified base URL the app is served at (used for building links in
# emails, invitation URLs, etc.). No trailing slash.
APP_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Standard libpq connection string. In Docker Compose this points at the
# `db` service; locally it points at your own Postgres instance.
DATABASE_URL=postgresql://yeffohub:yeffohub@localhost:5432/yeffohub

# Only used by compose.yaml to configure the `db` service itself — the app
# always connects via DATABASE_URL above, not these directly.
POSTGRES_USER=yeffohub
POSTGRES_PASSWORD=yeffohub
POSTGRES_DB=yeffohub

# --- Auth.js ---
# Random 32+ byte secret used to sign/encrypt Auth.js internals. Generate
# with: openssl rand -base64 32
AUTH_SECRET=

# --- Owner bootstrap (see scripts/bootstrap-owner.ts, docs/deployment.md) ---
# Only read once, by the bootstrap script, to create the first OWNER
# account when none exists yet. Unset/remove after first successful run.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=

# --- Secrets encryption (Phase 4+, referenced now for forward-compatibility) ---
# Server-side master key for encrypting stored integration/SMTP secrets at
# rest (never returned to the browser). Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# --- Business SMTP (wired starting Phase 4; env names reserved now) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Google Cloud Storage (wired starting Phase 6; env names reserved now) ---
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Path to a mounted service-account key file (never committed to the repo;
# see docs/decisions/0005-gcs-storage-abstraction.md).
GOOGLE_APPLICATION_CREDENTIALS=
